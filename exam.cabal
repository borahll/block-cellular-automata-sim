cabal-version:      3.0
name:               exam
version:            1.0.0.0
build-type:         Simple

common common
    default-language: Haskell2010
    ghc-options: -Wall -fno-omit-yields

library
    import: common
    hs-source-dirs: src
    build-depends:
        base
      , megaparsec
      , tasty
      , tasty-hunit
      , tasty-quickcheck
      , QuickCheck
      , random
    exposed-modules:
        APL.AST
        APL.Eval
        APL.Parser
        APL.Monad
        Galapagos.Rules
        Galapagos.Parser
        BlockAutomaton.Simulation
        BlockAutomaton.Rules
        BlockAutomaton.Server
        GenServer
        Tests

test-suite exam-test
    import: common
    type: exitcode-stdio-1.0
    main-is: runtests.hs
    build-depends:
        base
      , tasty
      , exam

executable viewer
    import: common
    main-is: viewer.hs
    build-depends:
        base
      , exam
      , random
